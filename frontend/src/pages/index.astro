---
import Layout from '../layouts/Layout.astro';
---

<Layout title="La Familia Sanjur - NAS">
  <div class="relative min-h-screen overflow-hidden">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a1a] via-[#1a1a3e] to-[#0a0a1a]">
      <div class="absolute inset-0 opacity-30">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-500 rounded-full blur-[128px] animate-float"></div>
        <div class="absolute top-1/3 right-1/4 w-80 h-80 bg-purple-500 rounded-full blur-[128px] animate-float" style="animation-delay: 2s"></div>
        <div class="absolute bottom-1/4 right-1/3 w-64 h-64 bg-pink-500 rounded-full blur-[128px] animate-float" style="animation-delay: 4s"></div>
      </div>
    </div>

    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(129, 140, 248, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(129, 140, 248, 0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <!-- Floating orbs -->
    <div class="absolute top-20 left-10 w-2 h-2 bg-indigo-400 rounded-full animate-pulse"></div>
    <div class="absolute top-40 right-20 w-3 h-3 bg-purple-400 rounded-full animate-pulse" style="animation-delay: 1s"></div>
    <div class="absolute bottom-40 left-1/4 w-2 h-2 bg-pink-400 rounded-full animate-pulse" style="animation-delay: 2s"></div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-4 text-center">
      <!-- Decorative line -->
      <div class="flex items-center gap-4 mb-8 animate-fade-in">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-indigo-400"></div>
        <div class="w-2 h-2 rotate-45 bg-indigo-400"></div>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-indigo-400"></div>
      </div>

      <!-- Main title -->
      <h1 class="text-6xl md:text-8xl lg:text-9xl font-extrabold tracking-tight animate-slide-up mb-6">
        <span class="bg-gradient-to-r from-indigo-300 via-purple-300 to-pink-300 bg-clip-text text-transparent">
          La Familia
        </span>
        <br />
        <span class="bg-gradient-to-r from-amber-200 via-yellow-300 to-orange-300 bg-clip-text text-transparent">
          Sanjur
        </span>
      </h1>

      <!-- Tagline -->
      <p class="text-lg md:text-xl text-gray-400 max-w-2xl animate-slide-up mb-12" style="animation-delay: 0.2s">
        Nuestro rincón digital. Comparte, guarda y revive los momentos que nos hacen únicos.
      </p>

      <!-- CTA Button -->
      <a
        href="/profiles"
        class="group relative inline-flex items-center gap-3 px-10 py-4 text-lg font-semibold text-white rounded-full animate-slide-up transition-all duration-300 hover:scale-105"
        style="animation-delay: 0.4s"
      >
        <span class="absolute inset-0 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full opacity-90 group-hover:opacity-100 transition-opacity"></span>
        <span class="absolute inset-0 rounded-full animate-pulse-glow opacity-50"></span>
        <span class="relative">Entrar a la Familia</span>
        <svg class="relative w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <!-- Bottom decoration -->
      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-indigo-400/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </div>
</Layout>
